extends Node
class_name Q05Director

## Q05 — The Contaminated Water.  This director creates its markers relative
## to the player so it remains playable in the current open wetlands level.

const SnakeScene = preload("res://enemies/snake.tscn")
const GenomeSiteScene = preload("res://levels/water_monitor_genome_site.tscn")

enum State { INIT, TRAVEL, SNAKE, FOLLOW_TRAIL, INVESTIGATE_WATER, AWAITING_GENOME, AWAITING_TRANSFORMATION, DONE }

var _state := State.INIT
var _marker: Node3D
var _snake: Node
var _site: WaterMonitorGenomeSite
var _snake_timer := 0.0

func _ready() -> void:
	add_to_group("q05_director")
	if not PlayerData.q04_completed or PlayerData.q05_completed:
		return
	match PlayerData.get_quest_checkpoint("q05"):
		"travel": _resume_marker(State.TRAVEL, "Follow the biological signal", "Move deeper into the contaminated wetlands.", 20.0)
		"snake": call_deferred("_start_snake_encounter")
		"follow_trail": _resume_marker(State.FOLLOW_TRAIL, "Follow the snake's trail", "Fresh tracks lead toward the contaminated water.", 18.0)
		"investigate_water": _resume_marker(State.INVESTIGATE_WATER, "Investigate the contaminated water", "Sterling's signal is strongest near the orange glow.", 12.0)
		"awaiting_genome": call_deferred("_show_genome_site")
		"awaiting_transformation": call_deferred("_resume_transformation")
		"completed": _state = State.DONE
		_: call_deferred("_begin")

func _begin() -> void:
	_resume_marker(State.TRAVEL, "Follow the biological signal", "Move deeper into the contaminated wetlands.", 20.0)

func _resume_marker(next_state: State, title: String, desc: String, distance: float) -> void:
	_state = next_state
	_marker = _make_marker(_grounded_point(_player_position() + Vector3(0, 0, distance)))
	PlayerData.set_quest_checkpoint("q05", ["travel", "travel", "snake", "follow_trail", "investigate_water"][mini(int(next_state), 4)])
	PlayerData.set_objective(_marker, title, desc)

func _process(delta: float) -> void:
	if _state == State.SNAKE:
		_snake_timer += delta
		if _snake_timer >= 10.0:
			_retreat_snake()
		return
	if _state in [State.TRAVEL, State.FOLLOW_TRAIL, State.INVESTIGATE_WATER] and is_instance_valid(_marker):
		if _player_position().distance_to(_marker.global_position) > 4.0:
			return
		_marker.queue_free()
		_marker = null
		match _state:
			State.TRAVEL: _start_snake_encounter()
			State.FOLLOW_TRAIL: _resume_marker(State.INVESTIGATE_WATER, "Investigate the contaminated water", "Sterling's signal is strongest near the orange glow.", 12.0)
			State.INVESTIGATE_WATER: _show_genome_site()

func _start_snake_encounter() -> void:
	_state = State.SNAKE
	PlayerData.set_quest_checkpoint("q05", "snake")
	PlayerData.set_objective(null, "Repel the invasive snake", "Survive its attack. It may retreat into the reeds.")
	_snake = SnakeScene.instantiate()
	# This encounter is generated by Q05, so it must never be treated as a
	# placed, permanently-destroyable scene enemy by EnemyBase._ready().
	_snake.is_dynamic = true
	get_tree().current_scene.add_child(_snake)
	_snake.global_position = _grounded_point(_player_position() + Vector3(5, 0, 4))
	_snake.tree_exited.connect(_on_snake_left)
	var hud := get_tree().get_first_node_in_group("hud")
	if hud and hud.has_method("show_subtitle"):
		hud.show_subtitle("STERLING (RADIO)", "A snake! It is defending this stretch of water. Drive it back.", 5.0)

func _on_snake_left() -> void:
	if _state == State.SNAKE:
		_follow_trail()

func _retreat_snake() -> void:
	if is_instance_valid(_snake):
		_snake.queue_free()
	else:
		_follow_trail()

func _follow_trail() -> void:
	if _state != State.SNAKE:
		return
	_resume_marker(State.FOLLOW_TRAIL, "Follow the snake's trail", "Fresh tracks lead toward the contaminated water.", 18.0)

func _show_genome_site() -> void:
	_state = State.AWAITING_GENOME
	PlayerData.set_quest_checkpoint("q05", "awaiting_genome")
	if not is_instance_valid(_site):
		_site = GenomeSiteScene.instantiate() as WaterMonitorGenomeSite
		_site.name = "WaterMonitorGenomeSite"
		get_tree().current_scene.add_child(_site)
		_site.global_position = _grounded_point(_player_position() + Vector3(5, 0, 4))
		_site.genome_recovered.connect(_on_genome_recovered)
	_site.set_active(true)
	PlayerData.set_objective(_site, "Recover the Water Monitor genome", "The biological signal is coming from the glowing Water Monitor form.")

func _on_genome_recovered(_genome_site: WaterMonitorGenomeSite) -> void:
	_state = State.AWAITING_TRANSFORMATION
	PlayerData.set_quest_checkpoint("q05", "awaiting_transformation")
	PlayerData.set_objective(null, "Try Water Monitor form", "Open the form circle and select Water Monitor.")
	if not PlayerData.active_species_changed.is_connected(_on_species_changed):
		PlayerData.active_species_changed.connect(_on_species_changed)
	_on_species_changed(PlayerData.active_species)

func _resume_transformation() -> void:
	_on_genome_recovered(null)

func _on_species_changed(species_id: String) -> void:
	if _state != State.AWAITING_TRANSFORMATION or species_id != "water_monitor":
		return
	PlayerData.q05_completed = true
	PlayerData.set_quest_checkpoint("q05", "completed")
	PlayerData.set_objective(null, "Explore the deeper wetlands", "Use Water Monitor's power and durability to overcome the next obstacles.")
	_state = State.DONE
	if PlayerData.active_species_changed.is_connected(_on_species_changed):
		PlayerData.active_species_changed.disconnect(_on_species_changed)

func _make_marker(position: Vector3) -> Node3D:
	var marker := Node3D.new()
	marker.name = "Q05Marker"
	marker.global_position = position
	get_tree().current_scene.add_child(marker)
	var light := OmniLight3D.new()
	light.light_color = Color(1.0, 0.5, 0.08)
	light.light_energy = 3.0
	light.omni_range = 7.0
	marker.add_child(light)
	return marker

func _player_position() -> Vector3:
	var player := get_tree().get_first_node_in_group("player") as Node3D
	return player.global_position if player else Vector3.ZERO

func _grounded_point(point: Vector3) -> Vector3:
	var player := get_tree().get_first_node_in_group("player") as Node3D
	if player:
		var query := PhysicsRayQueryParameters3D.create(point + Vector3(0, 12, 0), point - Vector3(0, 20, 0))
		var hit := player.get_world_3d().direct_space_state.intersect_ray(query)
		if hit.has("position"):
			return (hit["position"] as Vector3) + Vector3(0, 0.2, 0)
	return point
